# ── Copier en .env.local (développement) ou saisir dans le gestionnaire de secrets de l'hébergeur. Ne jamais committer de valeurs réelles.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (projet dédié ECONOM.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # clé « publishable » / anon : publique par nature
SUPABASE_SERVICE_ROLE_KEY=              # SECRET : serveur uniquement

# Claude (Anthropic) — SECRET, serveur uniquement. Sans clé, le scanner et l'assistant affichent un repli propre.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5         # ex. claude-haiku-5-5 pour réduire les coûts

# Stripe (mode Test d'abord) — SECRETS
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=                   # créés par : node scripts/stripe-setup.mjs
STRIPE_PRICE_YEARLY=

# Tâches planifiées (16 caractères minimum) — SECRET
CRON_SECRET=

# Facultatif
RESEND_API_KEY=                         # e-mails transactionnels
EMAIL_FROM=                             # ex. ECONOM. <bonjour@ton-domaine.fr>
NEXT_PUBLIC_OAUTH_PROVIDERS=            # ex. google,apple (après configuration dans Supabase Auth)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=           # notifications push (non activées par défaut)
